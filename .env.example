# --- Database (Supabase Postgres) ---
# Use the "Connection pooling" string for DATABASE_URL and the direct string for DIRECT_URL
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring prices created in the Stripe dashboard
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ELITE="price_..."

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="LeadRelay <notifications@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="you@yourdomain.com"
# Random string; Vercel sends it as Authorization: Bearer <CRON_SECRET> to cron routes
CRON_SECRET="generate-a-long-random-string"
